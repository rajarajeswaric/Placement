#include <bits/stdc++.h>
using namespace std;


static int found(int arr[],int n,int tar,int l,int r)
{
    while(l<=r)
    {
        int mid = l+(r-l)/2;
        
        if(arr[mid] == tar)
        {
            return mid;
        }
        else if(tar<arr[mid])
        {
            r=mid-1;
        }
        else
        {
            l = mid + 1;
        }
    }
    return -1;
}

int main()
{
    int n=7;
    
    int arr[] = {1,2,3,4,5,6,7};
    
    
    
    int tar=5;
    
    sort(arr,arr+n);
    
    cout<<found(arr,n,tar,0,n-1);
    
    
    
}
