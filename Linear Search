#include <iostream>
using namespace std;


static int found(int arr[],int n,int tar)
{
    for(int i=0;i<n;i++)
    {
        if(arr[i]==tar)
        {
            return i;
        }
    }
    return -1;
}

int main()
{
    int n=5;
    
    int arr[] = {1,2,3,4,5};
    
    
    
    int tar=5;
    
    
    cout<<found(arr,n,tar);
    
    
    
}
